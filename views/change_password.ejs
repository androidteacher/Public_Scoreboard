<%- include('partials/header') %>

    <div class="container" style="max-width: 600px;">
        <div class="card glow-card">
            <h2><span class="icon">🔒</span> Change Password</h2>

            <% if (typeof error !=='undefined' && error) { %>
                <div class="alert text-center" style="border-color: var(--danger-color); color: var(--danger-color);">
                    <%= error %>
                </div>
                <% } %>

                    <form action="/change-password" method="POST">
                        <div class="form-group">
                            <label>Current Password</label>
                            <input type="password" name="currentPassword" required autofocus>
                        </div>
                        <div class="form-group">
                            <label>New Password</label>
                            <input type="password" name="newPassword" required>
                        </div>
                        <button type="submit" style="width: 100%;">Update Credentials</button>
                    </form>
        </div>
    </div>

    <%- include('partials/footer') %>