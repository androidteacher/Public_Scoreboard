<%- include('partials/header') %>

    <!-- Nice work, operator. You found the source. EasterEgg14: Flag-1227b635733ad8a665e877e174fbc3e8 -->
    <div class="card glow-card crt" style="position: relative; overflow: hidden; min-height: 80vh;">

        <div
            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 2px solid #222; padding-bottom: 1rem;">
            <h2 class="glitch" data-text="iCSI Cyber Range Leaderboard" style="border: none; margin: 0; padding: 0;">
                iCSI Cyber Range Leaderboard</h2>
            <div style="text-align: right; font-family: var(--font-mono); color: #888;">
                <span id="stats-label"
                    style="text-transform: uppercase; letter-spacing: 1px; font-size: 0.8em; margin-right: 10px; transition: opacity 0.5s;">Most
                    Solves Today:</span>
                <span id="stats-value" style="color: #666; transition: opacity 0.5s;">--</span>
            </div>
        </div>

        <div style="display: flex; gap: 20px;">
            <!-- Main Leaderboard -->
            <div style="flex: 2;">
                <!-- Search Box -->
                <div style="margin-bottom: 20px;">
                    <input type="text" id="scoreboardSearch" placeholder="SEARCH OPERATOR..."
                        style="width: 100%; max-width: 400px; font-family: var(--font-mono); font-size: 1rem; padding: 10px; background: rgba(0,0,0,0.5); border: 1px solid #444; color: var(--accent-color); text-transform: uppercase;">
                </div>
                <div class="leaderboard-grid">
                    <!-- Left Column -->
                    <div>
                        <table id="table-left">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Operator</th>
                                    <th style="width: 80px;">Score</th>
                                    <th style="width: 90px;">Solves</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <!-- Right Column -->
                    <div>
                        <table id="table-right">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Operator</th>
                                    <th style="width: 80px;">Score</th>
                                    <th style="width: 90px;">Solves</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

                <div class="pagination">
                    <button id="btn-prev" onclick="changePage(-1)">[ &lt; PREV ]</button>
                    <span id="page-indicator"
                        style="align-self: center; font-family: var(--font-mono); color: #888;">PAGE
                        1</span>
                    <button id="btn-next" onclick="changePage(1)">[ NEXT &gt; ]</button>
                </div>
            </div>

            <!-- Recent Solves Ticker -->
            <div style="flex: 1; min-width: 250px; border-left: 1px solid #444; padding-left: 20px;">
                <h4
                    style="color: var(--accent-color); text-align: center; margin-bottom: 15px; font-size: 1em; text-transform: uppercase; letter-spacing: 1px;">
                    Recent Solves</h4>
                <div id="ticker-container"
                    style="height: 250px; overflow: hidden; position: relative; background: rgba(0,0,0,0.3); border-radius: 4px;">
                    <div id="ticker-content" style="position: absolute; width: 100%; top: 100%;">
                        <!-- Populated by JS -->
                    </div>
                    <div id="ticker-empty"
                        style="display:none; text-align: center; padding-top: 40%; color: #666; font-size: 0.8em;">
                        No solves for 7 days!
                    </div>
                </div>

                <!-- First Blood Bonus Section -->
                <h4
                    style="color: var(--danger-color, #ff0055); text-align: center; margin-top: 25px; margin-bottom: 15px; font-size: 1em; text-transform: uppercase; letter-spacing: 1px; border-top: 1px solid #333; padding-top: 20px;">
                    Current First-Blood Bonus Flags</h4>
                <div id="first-blood-container" style="display: flex; flex-direction: column; gap: 10px;">
                    <!-- Populated by JS -->
                </div>

                <!-- First Blood Scroller -->
                <h4
                    style="color: var(--danger-color, #ff0055); text-align: center; margin-top: 25px; margin-bottom: 15px; font-size: 1em; text-transform: uppercase; letter-spacing: 1px; border-top: 1px solid #333; padding-top: 20px;">
                    Current First-Blood Solves
                </h4>
                <div id="fb-scroller-container"
                    style="height: 150px; overflow: hidden; position: relative; background: rgba(0,0,0,0.3); border-radius: 4px; padding: 5px;">
                    <div id="fb-scroller-content" style="text-align: left; position: absolute; width: 100%; top: 100%;">
                        <!-- Populated by JS -->
                    </div>
                    <div id="fb-scroller-empty"
                        style="display:none; text-align: center; padding-top: 40%; color: #666; font-size: 0.9em;">
                        No first-blood solves!
                    </div>
                </div>

                <style>
                    @keyframes fb-scroll {
                        0% {
                            transform: translateX(0);
                        }

                        100% {
                            transform: translateX(-100%);
                        }
                    }
                </style>
            </div>
        </div>
    </div>

    <script>
        let allUsers = [];
        let filteredUsers = [];
        let currentPage = 1;
        const itemsPerPage = 60; // 30 per column

        const searchInput = document.getElementById('scoreboardSearch');

        // Apply the current search box value to the full user list.
        function applyFilter() {
            const query = (searchInput.value || '').toLowerCase();
            filteredUsers = query
                ? allUsers.filter(user => user.username.toLowerCase().includes(query))
                : allUsers;
        }

        // Fetch scoreboard data and re-render, preserving the active search + page.
        function loadScoreboard() {
            return fetch('/api/scoreboard')
                .then(res => res.json())
                .then(data => {
                    allUsers = data;
                    applyFilter();
                    // Clamp current page in case the filtered list shrank.
                    const maxPage = Math.max(1, Math.ceil(filteredUsers.length / itemsPerPage));
                    if (currentPage > maxPage) currentPage = maxPage;
                    renderPage();
                })
                .catch(err => console.error("Uplink Failed:", err));
        }

        // Search Logic
        searchInput.addEventListener('input', () => {
            applyFilter();
            currentPage = 1; // Reset to first page
            renderPage();
        });

        // Initial load + auto-refresh so scores and solve counts stay live.
        loadScoreboard();
        setInterval(loadScoreboard, 15000);

        // Reusable vertical scroller that re-polls the database at the end of
        // each loop, so the displayed data stays live without a page refresh.
        function createAutoScroller(opts) {
            const container = opts.container;
            const empty = opts.empty;
            const viewHeight = opts.viewHeight;
            const RETRY_MS = 15000; // re-check interval when there's nothing to scroll

            let trackHeight = 0;
            let currentTop = viewHeight;
            let reloading = false;
            let fits = false;
            let retryTimer = null;

            function scheduleRetry() {
                if (retryTimer) clearTimeout(retryTimer);
                retryTimer = setTimeout(() => { retryTimer = null; load(); }, RETRY_MS);
            }

            function render(data) {
                if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
                container.innerHTML = '';

                if (!data || data.length === 0) {
                    empty.style.display = 'block';
                    trackHeight = 0;
                    fits = false;
                    container.style.position = 'absolute';
                    container.style.display = 'block';
                    container.style.height = 'auto';
                    container.style.top = viewHeight + 'px';
                    scheduleRetry(); // keep checking so the first new solve appears
                    return;
                }

                empty.style.display = 'none';
                data.forEach(item => container.appendChild(opts.buildItem(item)));
                trackHeight = container.offsetHeight;

                if (opts.centerIfFits && trackHeight <= viewHeight) {
                    // Not enough content to scroll: center it, refresh periodically.
                    fits = true;
                    container.style.position = 'relative';
                    container.style.top = '0';
                    container.style.height = '100%';
                    container.style.display = 'flex';
                    container.style.flexDirection = 'column';
                    container.style.justifyContent = 'center';
                    scheduleRetry();
                } else {
                    fits = false;
                    container.style.position = 'absolute';
                    container.style.display = 'block';
                    container.style.height = 'auto';
                    currentTop = viewHeight;
                    container.style.top = currentTop + 'px';
                }
            }

            function load() {
                return fetch(opts.url)
                    .then(res => res.json())
                    .then(render)
                    .catch(err => console.error(opts.errorLabel || 'Scroller Failed:', err));
            }

            function tick() {
                if (!reloading && !fits && trackHeight > 0) {
                    currentTop -= 0.5; // scroll speed
                    if (currentTop < -trackHeight) {
                        // Loop complete -> poll the DB for fresh data before repeating.
                        reloading = true;
                        load().then(() => { reloading = false; });
                    } else {
                        container.style.top = currentTop + 'px';
                    }
                }
                requestAnimationFrame(tick);
            }

            load().then(() => tick());
        }

        // Recent Solves Ticker (auto-refreshing)
        createAutoScroller({
            url: '/api/recent',
            container: document.getElementById('ticker-content'),
            empty: document.getElementById('ticker-empty'),
            viewHeight: 250,
            centerIfFits: false,
            errorLabel: 'Ticker Failed:',
            buildItem: (solve) => {
                const el = document.createElement('div');
                el.style.padding = '8px';
                el.style.borderBottom = '1px solid #333';
                // SQLite returns "YYYY-MM-DD HH:MM:SS" which browsers parse as local.
                // We must treat it as UTC.
                const utcDate = new Date(solve.timestamp.replace(' ', 'T') + 'Z');
                const date = utcDate.toLocaleTimeString('en-US', { timeZone: 'America/Chicago', hour: '2-digit', minute: '2-digit' });
                el.innerHTML = `
                        <div style="color: var(--accent-color); font-size: 0.9em;"><b>${solve.username}</b></div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.8em; color: #bbb;">
                            <span>${solve.flag_name}</span>
                            <span>+${solve.points_awarded}</span>
                        </div>
                        <div style="font-size: 0.7em; color: #555; text-align: right;">${date}</div>
                    `;
                return el;
            }
        });

        // First Blood Fetch
        fetch('/api/first-blood')
            .then(res => res.json())
            .then(data => {
                const container = document.getElementById('first-blood-container');
                if (data.length === 0) {
                    container.innerHTML = '<div style="text-align: center; color: #666; font-size: 0.8em;">No active first blood bonuses.</div>';
                    return;
                }

                data.forEach(flag => {
                    const el = document.createElement('div');
                    el.style.padding = '10px';
                    el.style.background = 'rgba(255, 0, 85, 0.1)';
                    el.style.border = '1px solid var(--danger-color, #ff0055)';
                    el.style.borderRadius = '4px';
                    el.innerHTML = `
                        <div style="font-weight: bold; color: var(--danger-color, #ff0055);">${flag.name}</div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.85em; margin-top: 5px;">
                            <span style="color: #ccc;">${flag.points}pts</span>
                            <span style="color: #fff; font-weight: bold;">+${flag.first_blood_bonus} BONUS</span>
                        </div>
                    `;
                    container.appendChild(el);
                });
            })
            .catch(err => console.error("First Blood Failed:", err));

        // First Blood Solves Scroller (auto-refreshing)
        createAutoScroller({
            url: '/api/first-blood-solves',
            container: document.getElementById('fb-scroller-content'),
            empty: document.getElementById('fb-scroller-empty'),
            viewHeight: 150,
            centerIfFits: true,
            errorLabel: 'First Blood Solves Failed:',
            buildItem: (entry) => {
                const el = document.createElement('div');
                el.style.padding = '8px';
                el.style.borderBottom = '1px solid rgba(255, 0, 85, 0.2)';
                el.innerHTML = `
                        <div style="color: var(--danger-color, #ff0055); font-size: 0.9em;"><b>${entry.username}</b></div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.8em; color: #bbb;">
                            <span>${entry.flag_name}</span>
                            <span>+${entry.points}</span>
                        </div>
                        <div style="font-size: 0.7em; color: #ff5555; text-align: right; opacity: 0.7;">FIRST BLOOD</div>
                    `;
                return el;
            }
        });

        // Rotating Top Solvers (Daily, Weekly, Monthly) - auto-refreshing
        (function () {
            const labelEl = document.getElementById('stats-label');
            const valueEl = document.getElementById('stats-value');

            let stats = [];
            let currentIndex = 0;

            function load() {
                return fetch('/api/stats/top-solvers')
                    .then(res => res.json())
                    .then(data => {
                        stats = [
                            { label: "Most Solves Today:", value: data.daily },
                            { label: "Most Solves This Week:", value: data.weekly },
                            { label: "Most Solves This Month:", value: data.monthly }
                        ];
                    })
                    .catch(err => console.error("Top Solvers Failed:", err));
            }

            function updateDisplay() {
                if (stats.length === 0) return;

                // Fade Out
                labelEl.style.opacity = 0;
                valueEl.style.opacity = 0;

                setTimeout(() => {
                    // Update Content
                    const stat = stats[currentIndex];
                    labelEl.textContent = stat.label;

                    if (stat.value && stat.value.username !== 'None') {
                        valueEl.innerHTML = `<span class="pop-highlight">${stat.value.username}</span> (${stat.value.count} solves)`;
                    } else {
                        valueEl.innerHTML = 'No recent solves';
                    }

                    // Fade In
                    labelEl.style.opacity = 1;
                    valueEl.style.opacity = 1;

                    // Increment Index
                    currentIndex = (currentIndex + 1) % stats.length;

                    // Poll the DB for fresh numbers at the end of each full rotation.
                    if (currentIndex === 0) load();
                }, 500); // Wait for fade out
            }

            load().then(() => {
                // Initial Call
                updateDisplay();
                // Rotate every 4 seconds
                setInterval(updateDisplay, 4000);
            });
        })();

        function renderPage() {
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const pageData = filteredUsers.slice(start, end);

            const midPoint = Math.ceil(pageData.length / 2);
            const leftData = pageData.slice(0, midPoint);
            const rightData = pageData.slice(midPoint);

            renderTable(document.querySelector('#table-left tbody'), leftData, start);
            renderTable(document.querySelector('#table-right tbody'), rightData, start + midPoint);

            // Update Controls
            document.getElementById('page-indicator').textContent = `PAGE ${currentPage} / ${Math.ceil(filteredUsers.length / itemsPerPage) || 1}`;
            document.getElementById('btn-prev').disabled = currentPage === 1;
            document.getElementById('btn-next').disabled = end >= filteredUsers.length;
        }

        function renderTable(tbody, data, startIndex) {
            tbody.innerHTML = '';
            data.forEach((user, index) => {
                const rank = startIndex + index + 1;
                const tr = document.createElement('tr');

                const rankClass = rank <= 3 ? `rank-${rank}` : '';
                const solves = user.solves || 0;
                // Score color: top 10 by score -> green, everyone else -> blue.
                const scoreColor = rank <= 10 ? 'var(--success-color)' : 'var(--accent-color)';
                // Top 3 scores get an extra glow to really pop.
                const scoreClass = rank <= 3 ? 'score-val score-top3' : 'score-val';

                tr.innerHTML = `
                    <td class="${rankClass}">${rank}</td>
                    <td>
                        <a href="/user/${user.id}" style="text-decoration: none; color: inherit; display: block; width: 100%;"
                           onmouseover="this.style.color='var(--accent-color)'"
                           onmouseout="this.style.color='inherit'">
                            ${user.username}
                        </a>
                    </td>
                    <td class="${scoreClass}" style="color: ${scoreColor};">${user.score}</td>
                    <td style="font-family: var(--font-mono); color: #bbb; white-space: nowrap;">${solves} solve${solves === 1 ? '' : 's'}</td>
                `;
                tbody.appendChild(tr);
            });

            // Fill empty rows to maintain layout if needed? No, let height adjust.
        }

        function changePage(delta) {
            currentPage += delta;
            renderPage();
        }
    </script>

    <%- include('partials/footer') %>